# Cloud fallback for the agent panel — copy to server/.env (gitignored).
# Run from this directory:  node --env-file=.env index.mjs
# The key NEVER reaches the browser; only this server process uses it.

GEMINI_API_KEY=your-key-here

# Optional:
# Model (default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash
# Port (default: 8787)
PORT=8787